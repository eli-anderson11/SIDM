   "source": [
    "# test processing of data. Note that we are only running over one file, so I am not worried about unblinding\n",
    "fileset = utilities.make_fileset([samples[1]], \"llpNanoAOD_v2\", max_files=1, location_cfg=\"data.yaml\")\n",
    "output = runner.run(fileset, treename='Events', processor_instance=p)\n",
    "out = output[\"out\"]"
   ]
  },
