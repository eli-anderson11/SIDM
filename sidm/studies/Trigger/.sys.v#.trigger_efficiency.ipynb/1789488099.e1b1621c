    "num_ch = \"2mu2e_PhotonNumerator\"\n",
    "denom_ch = \"2mu2e_PhotonDenominator\"\n",
    "#plot_name = \"muon_lj_dR\"\n",
    "plot_name = \"all_muon0_pt_vs_all_muon1_pt\"\n",
    "\n",
    "for sample in samples:\n",
    "    num = [out[sample][\"hists\"][plot_name][ num_ch, sum,:]\n",
    "           ]\n",
    "    denom = [out[sample][\"hists\"][plot_name][denom_ch, sum,:]\n",
    "             ]\n",
    "              \n",
    "plot_ratio_row(num,denom,sample,xlabel=\"Sub-leading muon pT [GeV]\")"
   ]
  },
